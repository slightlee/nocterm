{
  "name": "nocterm",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nocterm/desktop dev",
    "build": "pnpm --filter @nocterm/desktop build",
    "preview": "pnpm --filter @nocterm/desktop preview",
    "tauri": "pnpm --filter @nocterm/desktop tauri",
    "prepare": "husky",
    "lint": "eslint . --max-warnings 0",
    "stylelint": "stylelint \"apps/desktop/src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @nocterm/desktop test",
    "check": "pnpm governance:test && pnpm release:test && pnpm release:check && pnpm format:check && pnpm lint && pnpm stylelint && pnpm test && pnpm build",
    "cargo:fmt": "cargo fmt --all --check",
    "cargo:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "cargo:test": "cargo test --workspace",
    "cargo:check": "pnpm cargo:fmt && pnpm cargo:clippy && pnpm cargo:test",
    "release:check": "node scripts/check-release-version.mjs",
    "governance:test": "node --test scripts/repository-governance-contract.test.mjs",
    "release:test": "node --test scripts/check-release-version.test.mjs scripts/prepare-windows-artifact.test.mjs scripts/release-workflow-contract.test.mjs",
    "release:build:windows": "node scripts/prepare-windows-artifact.mjs",
    "check:staged": "lint-staged && git diff --cached --check",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
